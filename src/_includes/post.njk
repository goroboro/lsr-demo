{# Layout for Markdown news posts (src/news/*.md).
   Front matter the post can set:
     title, date, badge, description #}
{% extends "base.njk" %}
{% block content %}
    <section class="page-hero" aria-label="Page heading">
      <div class="container">
        <span class="eyebrow">Latest news</span>
        <h1>{{ data.title }}</h1>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="prose">
          {{ content | safe }}
          <p class="attribution">{{ data.badge }}</p>
        </div>
        <p class="mt-4 lead">The best way to find out how shared reading works is to visit a group &mdash; <a href="../../groups.html">see when and where we meet</a>.</p>
      </div>
    </section>
{% endblock %}
